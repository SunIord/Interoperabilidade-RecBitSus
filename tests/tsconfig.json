{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "..",
    "outDir": "../backend/.build-test",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["../backend/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["./*.ts", "../backend/*.ts", "../frontend/src/catalogo.ts"],
  "exclude": ["../backend/server.ts"]
}
